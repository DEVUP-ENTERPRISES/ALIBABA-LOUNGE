# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in real values.
# On Render, set these in the dashboard WITHOUT surrounding quotes — the
# dashboard stores values literally, unlike dotenv which strips quotes.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5050

# MongoDB connection string (Atlas in production)
MONGO_URI=mongodb://127.0.0.1:27017/sheesh
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Primary browser origin allowed to call this API. No trailing slash.
CLIENT_URL=http://localhost:3100
# Optional: extra allowed origins, comma-separated (apex + www, staging, etc.)
CLIENT_URLS=
# Set to "true" to also allow *.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false

# Required when NODE_ENV=production. Use a long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=900000
# Whole-venue budget: every staff tablet and guest phone shares one
# public IP. Login is limited separately and much more tightly.
RATE_LIMIT_MAX=1200

# Cloudinary — image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed credentials — used by `npm run seed`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Admin portal — secret slug (must match frontend NEXT_PUBLIC_ADMIN_SLUG)
ADMIN_SLUG=admin

# Firebase Admin SDK — service account.
# Paste FIREBASE_PRIVATE_KEY with literal \n escapes and NO wrapping quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=

# OpenRouter — powers "goes well with" suggestions on the ordering page.
# Optional: without a key the API falls back to deterministic pairing rules,
# so ordering keeps working either way.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── Clover (pay at the table) ─────────────────────────────────────────
# The guest orders here, the tab appears on the terminal, staff take payment
# there. Leave blank and ordering carries on working with no Clover at all.
# Sandbox: https://sandbox.dev.clover.com  Live US: https://api.clover.com
CLOVER_BASE_URL=https://sandbox.dev.clover.com
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
